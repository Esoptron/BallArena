# Godot's generated imports and editor data.
.godot/
# Exported builds and captured test images.
/builds/
/test-captures/

# Local imports left by older editor scans of campaign evidence (preserve files).
/docs/campaign/**/*.import
/docs/campaign/**/*.translation

# Python tooling caches and local signing credentials.
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
*.jks
*.keystore
